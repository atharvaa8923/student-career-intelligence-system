# ── App ───────────────────────────────────────────────────────────────
APP_NAME=SyllaCheck
APP_ENV=development           # development | production
SECRET_KEY=change-me-to-a-long-random-string-in-production
DEBUG=true

# ── Database ──────────────────────────────────────────────────────────
POSTGRES_DB=syllacheck
POSTGRES_USER=syllacheck
POSTGRES_PASSWORD=devpassword
DATABASE_URL=postgresql+asyncpg://syllacheck:devpassword@db:5432/syllacheck

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── OpenAI ────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o

# ── File Upload ───────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=20
ALLOWED_EXTENSIONS=pdf,docx,doc

# ── Reports (Phase 7) ─────────────────────────────────────────────────
# Directory where generated PDF and Excel reports are stored inside the container
REPORT_DIR=/app/reports

# The URL your frontend is served from.
FRONTEND_URL=http://localhost:5173

# ── Scraping ──────────────────────────────────────────────────────────
SCRAPE_INTERVAL_HOURS=24
MAX_JOBS_PER_SOURCE=500
PLAYWRIGHT_HEADLESS=true

# ── CORS ──────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
SUPABASE_URL=https://rrabxkxqyrgbgakwljmf.supabase.co
SUPABASE_PUBLISHABLE_KEY=
DB_SSL_CA=/absolute/path/to/prod-supabase.cer
