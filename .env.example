# Root environment for scripts/dev-up.sh and scripts/health.sh.
# Copy to .env (git-ignored) and fill in. Never commit real values.
# Use the dev project only; staging/production credentials never belong on a
# developer machine (ADR-0010).

# Supabase (publishable key only; never a service-role/secret key)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Database connections used by the two backends (runtime role, not the owner,
# once Phase 2 creates it). Same database, different driver prefixes.
JSOM_DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/postgres
SYLLABUS_DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:<port>/postgres

# Verified TLS: absolute path to the Supabase root certificate.
# implementations/supabase-foundation/certs/supabase-root-2021.pem is committed;
# confirm it matches Dashboard -> Database Settings -> SSL Configuration.
DB_SSL_CA=
APP_ENV=production

# Python interpreter with SyllabusCheck requirements installed.
SYLLABUS_PYTHON=implementations/syllabus-check/.venv/bin/python

# scripts/health.sh overrides (leave empty to skip a check)
# JSOM_API_URL=http://127.0.0.1:5000
# SYLLABUS_API_URL=http://127.0.0.1:8000
